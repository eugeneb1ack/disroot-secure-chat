FROM node:22-alpine
WORKDIR /relay
COPY lib/secure-chat-protocol.ts lib/secure-chat-store.ts lib/secure-chat-guard.ts lib/secure-chat-handler.ts ./lib/
COPY scripts/secure-chat-relay.mjs ./scripts/
ENV NODE_ENV=production NODE_OPTIONS=--max-old-space-size=128
ENV CHAT_RELAY_HOST=0.0.0.0 CHAT_RELAY_PORT=3000
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 CMD wget -qO- http://127.0.0.1:3000/healthz >/dev/null || exit 1
CMD ["node", "--experimental-strip-types", "scripts/secure-chat-relay.mjs"]
